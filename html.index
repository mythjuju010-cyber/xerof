<script>
function setText(id,t){var e=document.getElementById(id);if(e)e.innerText=t;}
function setHtml(id,t){var e=document.getElementById(id);if(e)e.innerHTML=t;}
var pairs=[{sym:'XAUUSD',price:3873.04,dec:2,pre:'$'},{sym:'EURUSD',price:1.0845,dec:4,pre:''},{sym:'GBPUSD',price:1.2712,dec:4,pre:''},{sym:'USDJPY',price:154.32,dec:2,pre:''},{sym:'BTCUSD',price:97450,dec:0,pre:'$'}];
var cur=pairs[0],wins=0,losses=0,auto=false,autoTimer=null,lastCode='';
var trialCodes=['XEROF-TRIAL-001','XEROF-TRIAL-002','XEROF-TRIAL-003'];
var proCodes=['XEROF-PRO-001','XEROF-PRO-002','XEROF-256-OWNER'];
function renderPairs(){var h='';pairs.forEach(function(p,i){h+='<button type="button" class="pair-btn '+(p.sym===cur.sym?'active':'')+'" onclick="selectPair('+i+')">'+p.sym+' '+p.pre+p.price.toFixed(p.dec)+'</button>'});setHtml('pairBar',h);}
function selectPair(i){cur=pairs[i];renderPairs();setText('pairLabel',cur.sym+' • LIVE');setText('price',(cur.pre||'')+cur.price.toFixed(cur.dec));checkSignal();}
function unlock(t,exp){var b=document.getElementById('signalBlur');if(b)b.classList.remove('locked-blur');var d=Math.ceil((exp-Date.now())/86400000);setHtml('statusBadge','<span style="background:#14532D;color:#22C55E;padding:6px 10px;border-radius:20px;font-size:12px;font-weight:800">✅ '+t+' ACTIVE - '+d+' DAYS LEFT</span>');}
function doAuth(name,email,pass,msgId){if(!name||!email||!pass){setText(msgId,'❌ Fill all fields');return;}try{localStorage.setItem('xerof_user',JSON.stringify({name:name,email:email}));}catch(e){}var exp=Date.now()+2*86400000;try{localStorage.setItem('xerof_access',JSON.stringify({code:'XEROF-TRIAL-001',type:'TRIAL',expires:exp}));}catch(e){}unlock('TRIAL',exp);setText(msgId,'✅ Welcome '+name+'! Unlocked.');setText('dashStatus','✅ Signed In as '+name);setTimeout(function(){window.location.hash='dashboard';},800);}
function checkSignal(){var m=[{t:'🟢 BUY - '+cur.sym+' | MSNR + CRT LONG',d:'Swept Asia Low → MSS Up | ENTRY: '+cur.price.toFixed(cur.dec)+' | SL: Below Sweep | TP: Next High | Risk 1%'},{t:'🔴 SELL - '+cur.sym+' | MSNR + CRT SHORT',d:'Swept Asia High → MSS Down | ENTRY: '+cur.price.toFixed(cur.dec)+' | SL: Above Sweep | TP: Next Low | Risk 1%'},{t:'⏳ NO TRADE - '+cur.sym+' | WAIT FOR SWEEP',d:'No Sweep yet. No Trade. Wait for Asia High/Low sweep.'}];var s=m[Math.floor(Math.random()*m.length)];setText('signalText',s.t);setText('signalDetail',s.d);}
function genCode(t){var n=Math.floor(100+Math.random()*900);var code=t==='TRIAL'?'XEROF-TRIAL-'+n:'XEROF-PRO-'+n;lastCode=code;var ex=[];try{ex=JSON.parse(localStorage.getItem('xerof_extra_codes')||'[]');}catch(e){}ex.push(code);try{localStorage.setItem('xerof_extra_codes',JSON.stringify(ex));}catch(e){}var g=document.getElementById('genResult');if(g)g.innerHTML+='<div style="background:#0A0A12;padding:10px;border-radius:8px;margin-top:6px">✅ <b>'+code+'</b> - '+(t==='TRIAL'?'2 Days':'30 Days')+'</div>';}
function bind(id,fn){var e=document.getElementById(id);if(e)e.addEventListener('click',fn);}
bind('btnAnalyze',checkSignal);
bind('btnAuto',function(){auto=!auto;var b=document.getElementById('btnAuto');if(b)b.innerText=auto?'🤖 AUTO: ON':'🤖 AUTO: OFF';if(auto){autoTimer=setInterval(checkSignal,30000);}else{clearInterval(autoTimer);}});
bind('btnWin',function(){wins++;setText('todayCount',(wins+losses)+' / 3');setText('winRate',Math.round(wins/(wins+losses)*100)+'%');});
bind('btnLoss',function(){losses++;setText('todayCount',(wins+losses)+' / 3');setText('winRate',Math.round(wins/(wins+losses)*100)+'%');});
bind('btnActivate',function(){var c=document.getElementById('codeInput').value.trim().toUpperCase();var ex=[];try{ex=JSON.parse(localStorage.getItem('xerof_extra_codes')||'[]');}catch(e){}var ok=trialCodes.concat(ex).indexOf(c)>-1||proCodes.concat(ex).indexOf(c)>-1;if(!ok){setText('codeMsg','❌ Invalid. Use XEROF-TRIAL-001 or Sign In');return;}var exp=Date.now()+(c.indexOf('PRO')>-1?30:2)*86400000;try{localStorage.setItem('xerof_access',JSON.stringify({code:c,type:'PREMIUM',expires:exp}));}catch(e){}unlock('PREMIUM',exp);setText('codeMsg','✅ Activated!');});
bind('btnCalc',function(){var bal=parseFloat(document.getElementById('bal').value);if(!bal){alert('Enter balance');return;}var risk=parseFloat(document.getElementById('riskPct').value)||1;var sl=parseFloat(document.getElementById('slVal').value)||1.5;var rm=bal*risk/100;var lot=Math.max(0.01,(rm/sl*0.01)).toFixed(2);setHtml('calcResult','<b>Balance:</b> $'+bal+'<br><b>Risk:</b> $'+rm.toFixed(2)+'<br><b>Your Lot:</b> '+lot+' Lot');});
bind('btnSignup',function(){doAuth(document.getElementById('fName').value,document.getElementById('fEmail').value,document.getElementById('fPass').value,'authMsg');});
bind('btnSignin',function(){doAuth(document.getElementById('sEmail').value,document.getElementById('sEmail').value,document.getElementById('sPass').value,'authMsg2');});
bind('btnGenTrial',function(){genCode('TRIAL');});
bind('btnGenPro',function(){genCode('PRO');});
bind('btnCopy',function(){if(!lastCode){alert('Generate first');return;}try{navigator.clipboard.writeText(lastCode);}catch(e){}alert('Copied: '+lastCode);});
function updateClock(){var now=new Date();setText('liveClock',now.toLocaleTimeString('en-GB'));setText('liveDate',now.toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long'}));setText('todayDate',now.toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long'}));var h=now.getHours();setText('sessionBadge',h>=10&&h<16?'LONDON':h>=16&&h<22?'NEW YORK':h>=1&&h<10?'ASIA':'OFF');setText('dailyBias',now.getDate()%3===0?'Today Bias: BULLISH - Sweep Asia LOW then BUY':now.getDate()%3===1?'Today Bias: BEARISH - Sweep Asia HIGH then SELL':'Today Bias: RANGE - Wait for Sweep.');}
async function fetchLive(){try{var r=await fetch('https://data-asg.goldprice.org/dbXRates/USD');var d=await r.json();var gold=d.items[0].xauPrice;if(gold&&gold>1000)pairs[0].price=gold;}catch(e){}setText('price',(cur.pre||'')+cur.price.toFixed(cur.dec));setText('tickerGold',pairs[0].price.toLocaleString('en-US',{minimumFractionDigits:2}));setText('lastUpdated','Updated: '+new Date().toLocaleTimeString('en-GB'));renderPairs();}
try{renderPairs()
