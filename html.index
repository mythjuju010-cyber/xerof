*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,system-ui,sans-serif;-webkit-tap-highlight-color:transparent}
body{background:#0A0A12;color:#E6EAF2;padding-bottom:92px}
.top{position:sticky;top:0;z-index:60;background:#0A0A12;border-bottom:1px solid #222;display:flex;justify-content:space-between;align-items:center;padding:12px 14px;gap:8px}
.logo{font-size:20px;font-weight:900}.logo span{color:#C9A227}
a{color:inherit;text-decoration:none}
.btn{display:flex;align-items:center;justify-content:center;gap:6px;padding:15px 18px;border-radius:999px;font-weight:800;font-size:15px;border:none;cursor:pointer;min-height:52px;touch-action:manipulation;background:#8B5CF6;color:#fff;transition:transform .1s}
.btn:active{transform:scale(.96);opacity:.85}
.btn-dark{background:#1A1A28;color:#fff;border:1px solid #444}.btn-gold{background:#F59E0B;color:#111}.btn-green{background:#15803D;color:#fff}.btn-white{background:#fff;color:#111}.btn-full{width:100%;margin-top:10px}
.hero{padding:24px 16px;text-align:center}.hero h1{font-size:30px;line-height:1.1}.hero h1 span{color:#A855F7}.hero p{color:#A1A1AA;font-size:14px;margin:12px auto;line-height:1.6;max-width:620px}
.card{background:#15151F;border:1px solid #26263A;border-radius:16px;margin:12px 16px;padding:16px}.card p{font-size:13px;color:#A1A1AA;line-height:1.6;margin-top:6px}
input,select,textarea{width:100%;padding:14px;border-radius:10px;border:1px solid #333;background:#0A0A12;color:#fff;margin-top:8px;font-size:15px}
label{font-size:12px;font-weight:700;margin-top:12px;display:block}
.pair-bar{display:flex;gap:8px;overflow-x:auto;padding:10px 0}
.pair-btn{white-space:nowrap;background:#1E293B;border:1px solid #334155;color:#fff;padding:11px 15px;border-radius:20px;font-size:12px;font-weight:700;cursor:pointer;min-height:44px}.pair-btn.active{background:#C9A227;color:#111}
.price{font-size:32px;font-weight:900}
.signal-box{background:#0A0A12;border:2px solid #C9A227;border-radius:12px;padding:14px}
.locked-blur{filter:blur(5px);pointer-events:none}
.action-row{display:flex;gap:8px;margin-top:12px}.action-row .btn{flex:1}
.tabs{position:fixed;bottom:0;left:0;right:0;background:#0B1220;border-top:1px solid #333;display:flex;padding:8px;z-index:60}.tab{flex:1;text-align:center;padding:11px;font-size:11px;color:#94A3B8;border-radius:10px;min-height:54px;display:flex;flex-direction:column;align-items:center;justify-content:center}
.pay-box{background:#fff;color:#111;border-radius:14px;padding:16px;margin-top:12px}.pay-row{display:flex;justify-content:space-between;background:#F3EFFF;padding:12px;border-radius:10px;margin:8px 0;font-size:14px}.pay-row b{color:#2D0A5E}
.team{display:flex;gap:12px;align-items:center;background:#0A0A12;border:1px solid #333;border-radius:14px;padding:12px;margin-top:10px}
.avatar{width:62px;height:62px;border-radius:50%;background:linear-gradient(135deg,#8B5CF6,#F59E0B);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0;border:2px solid #22C55E}
.verified{display:inline-block;background:#14532D;color:#22C55E;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:800}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:100;align-items:flex-start;justify-content:center;padding:16px;overflow-y:auto}
.modal:target{display:flex}
.modal-box{background:#15151F;border:1px solid #333;border-radius:16px;padding:20px;width:100%;max-width:420px}
</style></head><body>

